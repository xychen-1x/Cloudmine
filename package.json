{
  "name": "weathercast",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:build": "node scripts/check-build.mjs --scan .next --sentinel WC_AI_BUNDLE_SENTINEL_2026_11_24 --forbid-in .next/static=GEMINI_API_KEY,GROQ_API_KEY",
    "prebuild": "npm run lint && npm run typecheck && npm test",
    "postbuild": "npm run check:build"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
